+Id EmitContext::LoadBdaEntry(Id address,Id guest_offset) {
+    const Id page64=OpShiftRightLogical(U64,address,Constant(U64,u64{profile.sparse_page_shift}));
+    const Id page=OpUConvert(U32[1],page64);
+    const Id valid=OpULessThan(U1[1],page64,Constant(U64,Common::BdaTable::Pages(profile.sparse_page_shift)));
+    const auto [table,pointer]=buffers[bda_pagetable_index].Alias(PointerType::U64);
+    const Id index=profile.two_level_bda
+        ? OpShiftRightLogical(U32[1],page,ConstU32(Common::BdaTable::LeafBits)) : page;
+    const Id safe=OpSelect(U32[1],valid,OpIAdd(U32[1],index,guest_offset),u32_zero_value);
+    const Id root=OpLoad(U64,OpAccessChain(pointer,table,u32_zero_value,safe));
+    Id entry=root;
+    if(profile.two_level_bda) {
+        const Id slot=OpBitwiseAnd(U32[1],page,ConstU32(u32(Common::BdaTable::LeafEntries-1)));
+        const Id offset=OpShiftLeftLogical(U64,OpUConvert(U64,slot),ConstU32(3U));
+        const Id leaf=OpConvertUToPtr(PhysicalPointer(U64),OpIAdd(U64,root,offset));
+        entry=OpLoad(U64,leaf,spv::MemoryAccessMask::Aligned,8u);
+    }
+    return OpSelect(U64,valid,entry,u64_zero_value);
 }
 
