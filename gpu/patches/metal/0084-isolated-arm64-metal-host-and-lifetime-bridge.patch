+// SPDX-License-Identifier: GPL-2.0-or-later
+#ifdef NDEBUG
+#error "Lifetime transport tests require assertions"
+#endif
+#include <cassert>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
