diff --git a/gpu/shim/bbport_submit_timing.h b/gpu/shim/bbport_submit_timing.h
new file mode 100644
--- /dev/null
+++ b/gpu/shim/bbport_submit_timing.h
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <string>
+#include <unistd.h>
+
+namespace BbSubmitTiming {
+// Private, bounded metadata only. Never enabled by a normal launch. All timestamps use
+// CACurrentMediaTime / MTLCommandBuffer GPU time (seconds), not translated x86 TSC values.
+constexpr unsigned Capacity = 2048;
+struct Entry {
+    std::uint64_t queue, tick;
+    unsigned frame, role;
+    double commit, start, end, callback;
+};
+struct State {
+    const char* path = std::getenv("BB_MTL_SUBMIT_AUDIT");
+    const char* trigger = std::getenv("BB_MTL_SUBMIT_TRIGGER");
+    std::unique_ptr<std::array<Entry, Capacity>> entries = path && trigger
+        ? std::make_unique<std::array<Entry, Capacity>>() : nullptr;
+    std::atomic<bool> active{false};
+    std::atomic<unsigned> issued{0}, completed{0};
+    // Only the first caller for a frame polls the trigger, across both queue roles.
+    std::atomic<unsigned> checked_frame{~0u};
+};
+inline State& Get() { static State s; return s; }
+inline unsigned Begin(unsigned frame) {
+    auto& s = Get();
+    if (!s.entries) return Capacity;
+    if (!s.active.load(std::memory_order_acquire)) {
+        if (s.checked_frame.exchange(frame, std::memory_order_relaxed) == frame ||
+            access(s.trigger, F_OK) != 0) return Capacity;
+        s.active.store(true, std::memory_order_release);
+    }
+    // Saturate; diagnostics cannot overflow a counter during a long session.
+    unsigned i=s.issued.load(std::memory_order_relaxed);
+    while(i<Capacity && !s.issued.compare_exchange_weak(i,i+1,std::memory_order_relaxed)) {}
+    return i;
+}
+inline void Complete(unsigned index, const Entry& entry) {
+    if (index>=Capacity) return;
+    auto& s=Get();
+    (*s.entries)[index]=entry;
+    // The release sequence publishes every completed slot before the final writer reads it.
+    if(s.completed.fetch_add(1,std::memory_order_acq_rel)+1 != Capacity) return;
+    const std::string pending=std::string{s.path}+".tmp";
+    if(FILE* f=std::fopen(pending.c_str(),"w")) {
+        std::fprintf(f,"queue,tick,frame,role,commit_s,start_s,end_s,callback_s\n");
+        for(const auto& e:*s.entries)
+            std::fprintf(f,"%llu,%llu,%u,%u,%.9f,%.9f,%.9f,%.9f\n",
+                (unsigned long long)e.queue,(unsigned long long)e.tick,e.frame,e.role,e.commit,e.start,e.end,e.callback);
+        if(std::fclose(f)==0)std::rename(pending.c_str(),s.path);
+    }
+}
+} // namespace BbSubmitTiming
diff --git a/tests/test_submit_timing.cpp b/tests/test_submit_timing.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_submit_timing.cpp
@@ -0,0 +1,50 @@
+#include "bbport_submit_timing.h"
+#include "bbport_toggles.h"
+#include <cassert>
+#include <filesystem>
+#include <fstream>
+#include <thread>
+#include <vector>
+
+int main(int argc, char**) {
+    using namespace BbSubmitTiming;
+    if (argc==1) {
+        assert(Begin(1)==Capacity && !Get().entries);
+        // Actual legacy counter: a later-ended callback arriving first hides earlier work.
+        BbStats::NoteGpuInterval(20,25);
+        BbStats::NoteGpuInterval(10,21);
+        assert(BbStats::gpu_busy_ns.load()==5000000000ULL); // true interval union is 15 s
+        puts("disabled recorder allocates nothing; legacy out-of-order undercount reproduced");
+        return 0;
+    }
+    char temp[]="/private/tmp/bb-submit-timing-XXXXXX";
+    const auto* dir=mkdtemp(temp);assert(dir);
+    const std::filesystem::path root=dir, out=root/"trace.csv", trigger=root/"trigger";
+    setenv("BB_MTL_SUBMIT_AUDIT",out.c_str(),1);setenv("BB_MTL_SUBMIT_TRIGGER",trigger.c_str(),1);
+    assert(Begin(1)==Capacity && !Get().active);
+    { std::ofstream file{trigger};file<<1; }
+    std::vector<std::jthread> threads;
+    for(unsigned t=0;t<8;++t)threads.emplace_back([t] {
+        for(unsigned frame=2;frame<1026;++frame) {
+            const unsigned i=Begin(frame);if(i>=Capacity)continue;
+            if((i&7)==0)std::this_thread::yield();
+            Complete(i,{t,i,frame,t&1,1.+i,1.1+i,1.2+i,1.3+i});
+        }
+    });
+    threads.clear();
+    assert(Get().issued==Capacity && Get().completed==Capacity && Begin(1027)==Capacity);
+    assert(sizeof(std::array<Entry,Capacity>)<=128*1024);
+    std::ifstream file{out};std::string line;unsigned lines=0;
+    std::vector<bool> seen(Capacity,false);
+    while(std::getline(file,line)) {
+        if(lines++) {
+            unsigned long long queue,tick;unsigned frame,role;double commit,start,end,callback;
+            assert(std::sscanf(line.c_str(),"%llu,%llu,%u,%u,%lf,%lf,%lf,%lf",&queue,&tick,&frame,&role,&commit,&start,&end,&callback)==8);
+            assert(tick<Capacity && !seen[tick]);seen[tick]=true;
+            assert(commit<start && start<end && end<callback);
+        }
+    }
+    assert(lines==Capacity+1 && !std::filesystem::exists(out.string()+".tmp"));
+    std::filesystem::remove_all(root);
+    puts("concurrent completion: 2048 unique records, atomic publication and capacity saturation passed");
+}
