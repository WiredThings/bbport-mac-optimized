+                                  db_desc.first ? texture_cache.GetImage(db_desc.first).image_uid : 0)) return;
+    auto scaled = dynamic;
+    const float fx = float(mirror.width) / state.width, fy = float(mirror.height) / state.height;
+    auto& vp = scaled.viewport_scissors.viewports[0];
+    vp.x *= fx; vp.y *= fy; vp.width *= fx; vp.height *= fy;
+    auto& sc = scaled.viewport_scissors.scissors[0];
+    sc.offset.x = std::lround(sc.offset.x * fx); sc.offset.y = std::lround(sc.offset.y * fy);
+    sc.extent.width = std::lround(sc.extent.width * fx); sc.extent.height = std::lround(sc.extent.height * fy);
+    // Per-pass guest=false propagates through both held and threaded replay. The extra draw
+    // must never contribute to the game's ZPASS counters or occlusion history.
+    impl->velocity_replaying = true;
+    impl->velocity_pipeline = variant;
+    const u64 before = impl->recorded_draws.load(std::memory_order_relaxed);
+    RecordDraw(&pipeline, mirror, draw, scaled);
+    scheduler.EndWithBarrier();
+    impl->velocity_pipeline = nullptr;
+    impl->velocity_replaying = false;
+    if (impl->recorded_draws.load(std::memory_order_relaxed) != before) velocity_mirror->Drawn();
+}
