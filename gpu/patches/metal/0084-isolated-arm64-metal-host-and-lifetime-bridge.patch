+}
+void InstallGuestHooks(void (*fresh)(u64,u64)) {
+    fresh_range_callback.store(fresh,std::memory_order_release);
+    g.control->lifetime.hooks_requested.store(1,std::memory_order_release);
+}
+int MemorySnapshot(u64* out,u64 count) {
+    if(!out || count<16)return 0;
+    u64 snapshot[16]{};
+    if(g.channel->Call(MsgMemorySnapshot,nullptr,0,snapshot,sizeof(snapshot))!=sizeof(snapshot) || snapshot[15])return 0;
+    std::copy_n(snapshot,16,out);return 1;
+}
