+id<MTLComputePipelineState> HostKernels::TextureTiling(const VideoCore::TilingDispatch& dispatch, bool proxy) {
+    const auto key=std::make_pair(proxy,TilingKey{32, true, dispatch.constants});
+    if(const auto i=texture_tiling.find(key);i!=texture_tiling.end())return i->second;
+    if(texture_tiling.size()>=32)return nil;
+    const auto source=TextureTilingSource(H::TILING_MACRO_32_COMP.msl);
+    if(source.empty()) {texture_tiling.emplace(key,nil);return nil;}
+    NSError* error=nil;
+    auto library=[dev.device newLibraryWithSource:[NSString stringWithUTF8String:source.c_str()]
+                                         options:CompileOptions() error:&error];
+    MTLFunctionConstantValues* values=[MTLFunctionConstantValues new];
+    for(const auto& spec:H::TILING_MACRO_32_COMP.spec_constants) {
+        if(spec.id>=dispatch.num_constants)continue;
+        if(spec.type==H::SpecConstant::Type::Bool) {
+            const bool value=dispatch.constants[spec.id]!=0;
+            [values setConstantValue:&value type:MTLDataTypeBool atIndex:spec.id];
+        } else {
+            const u32 value=dispatch.constants[spec.id];
+            [values setConstantValue:&value type:MTLDataTypeUInt atIndex:spec.id];
