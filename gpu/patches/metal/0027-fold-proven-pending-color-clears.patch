+            std::max<NSUInteger>(1,a.texture.width>>a.level)>=target.width &&
+            std::max<NSUInteger>(1,a.texture.height>>a.level)>=target.height;
+    };
+    for(unsigned i=0;i<8;++i)if(!large_enough(pass.colorAttachments[i]))return false;
