+    void Insert(const void* key,u64 start,u64 end,u8 access) {
+        ++stats.inserts;
+        Ref* ref=Lookup(key);
+        if(!ref) {
+            if(used==Resources)return;
+            ref=&refs[used++];ref->key=key;ref->size=0;ref->complete=true;
+        }
+        if(!ref->complete)return;
