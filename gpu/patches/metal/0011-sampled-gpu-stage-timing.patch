+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#import <Metal/Metal.h>
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
