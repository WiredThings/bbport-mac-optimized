+void LibraryReuseCases(Metal::Device& device, const fs::path& cache) {
+    std::printf("== bounded weak Metal library reuse\n");
+    const char* prior = std::getenv("BB_MTL_LIBRARY_REUSE");
+    const std::string previous = prior ? prior : "";
+    const bool had_prior = prior != nullptr;
+    setenv("BB_MTL_LIBRARY_REUSE","1",1);
+    {
+        Metal::ShaderCompiler compiler{device,cache};
+        std::array<Metal::CompileResult,4> results;
+        std::array<std::thread,4> workers;
+        std::atomic<unsigned> ready{}; std::atomic<bool> start{};
+        for (unsigned i=0;i<workers.size();++i) workers[i]=std::thread([&,i] {
+            ++ready;
+            while(!start.load()) std::this_thread::yield();
+            results[i]=compiler.Compile(kPatchFrag,0x7e57d000+i,"byte_identical_module");
+        });
+        while(ready.load()!=workers.size()) std::this_thread::yield();
+        start=true;
+        for(auto& worker:workers) worker.join();
+        for(auto& result:results) {
+            if(result.status!=CompileStatus::Ok || results[0].status!=CompileStatus::Ok ||
+                result.shader->library!=results[0].shader->library)
+                Fail("concurrent identical module did not share its Metal library");
+            if (&result != &results[0] && result.status == CompileStatus::Ok &&
+                results[0].status == CompileStatus::Ok &&
+                result.shader->cache_identity == results[0].shader->cache_identity)
+                Fail("library reuse merged module identities");
+            if (&result != &results[0] && result.shader.get() == results[0].shader.get())
+                Fail("library reuse aliased per-module shader metadata");
+        }
+        const auto stats=compiler.GetLibraryReuseStats();
+        std::printf("   concurrent real modules: %llu builds, %llu reuses, %llu waits\n",
+            (unsigned long long)stats.builds,(unsigned long long)stats.reuses,(unsigned long long)stats.waits);
+        if(stats.builds!=1 || stats.reuses!=3) Fail("duplicate Metal driver compilation");
+        auto bound0=compiler.Compile(kBindingFrag0,0x7e57d200,"binding_zero");
+        auto bound1=compiler.Compile(kBindingFrag1,0x7e57d201,"binding_one");
+        if(bound0.status!=CompileStatus::Ok || bound1.status!=CompileStatus::Ok ||
+           bound0.shader->library!=bound1.shader->library ||
+           !bound0.shader->Find(0,0,Metal::ShaderBinding::Kind::Buffer) ||
+           !bound1.shader->Find(0,1,Metal::ShaderBinding::Kind::Buffer))
+            Fail("identical Metal source with distinct SPIR-V binding metadata fixture");
+        auto vertex=compiler.Compile(kPatchVert,0x7e57d100,"module_identity_vs");
+        if(vertex.status!=CompileStatus::Ok) Fail("module identity vertex fixture");
+        else {
+            Metal::PsoCache pso{device,cache/"identities"};
+            auto key=MakeKey(0,0x7e57d100);
+            key.prim_type=AmdGpu::PrimitiveType::TriangleList;
+            key.stage_hashes[u32(Shader::SwStage::TessellationControl)]=0;
+            key.stage_hashes[u32(Shader::SwStage::TessellationEval)]=0;
+            const std::vector<Metal::VertexAttribute> attributes{{0,false,1}};
+            const std::array<const Metal::CompiledShader*,2> bindings{
+                bound0.shader.get(),bound1.shader.get()};
+            for(const auto* shader:bindings) if(shader) {
+                const auto* pipeline=pso.GetRenderPipeline(key,vertex.shader.get(),shader,
+                    {.vertex_attributes=attributes});
+                if(!pipeline || pipeline->fs!=shader)
+                    Fail("shared Metal function aliased distinct global binding numbers");
+                if(pso.GetRenderPipeline(key,vertex.shader.get(),shader,
+                       {.vertex_attributes=attributes})!=pipeline)
+                    Fail("same-module PSO stopped reusing its cache entry");
+            }
+        }
+    }
+    // Test memo ownership independently of any private driver caches. These NSObject tokens
+    // never enter a Metal pipeline; only the real module test above exercises Metal objects.
+    {
+        Metal::LibraryMemo memo;
+        __weak NSObject* observer;
+        @autoreleasepool {
+            NSObject* token=[NSObject new]; observer=token;
+            auto object=memo.Get("lifetime","main",false,[&] {
+                return Metal::MetalLibraryObjects{(id<MTLLibrary>)token,(id<MTLFunction>)token,{}};
+            });
+            if(!object.library) Fail("weak memo ownership fixture");
+        }
+        if(observer) Fail("library memo retained its object after the last owner released it");
+        @autoreleasepool {
+            NSObject* token=[NSObject new];
+            auto object=memo.Get("lifetime","main",false,[&] {
+                return Metal::MetalLibraryObjects{(id<MTLLibrary>)token,(id<MTLFunction>)token,{}};
+            });
+            if(object.reused || memo.Stats().builds!=2) Fail("expired weak entry not rebuilt");
+        }
+    }
+    {
+        Metal::LibraryMemo memo;
+        std::vector<Metal::MetalLibraryObjects> held;
+        const auto build=[] { NSObject* token=[NSObject new];
+            return Metal::MetalLibraryObjects{(id<MTLLibrary>)token,(id<MTLFunction>)token,{}}; };
+        held.push_back(memo.Get("source A","main",false,build));
+        held.push_back(memo.Get("source B","main",false,build));
+        held.push_back(memo.Get("source A","other",false,build));
+        held.push_back(memo.Get("source A","main",true,build));
+        held.push_back(memo.Get("source A","main",false,build));
+        if(memo.Stats().builds!=4 || memo.Stats().reuses!=1 ||
+           held[0].library!=held.back().library) Fail("source/entry/math memo key alias");
+        const auto fail=[] { return Metal::MetalLibraryObjects{nil,nil,"expected failure"}; };
+        memo.Get("failure","main",false,fail); memo.Get("failure","main",false,fail);
+        if(memo.Stats().builds!=6) Fail("failed library poisoned memo");
+        try {
+            memo.Get("exception","main",false,[]()->Metal::MetalLibraryObjects {
+                throw std::runtime_error("expected exception");
+            });
+            Fail("memo swallowed exception");
+        } catch(const std::runtime_error&) {}
+        held.push_back(memo.Get("exception","main",false,build));
+        if(memo.Stats().builds!=8) Fail("exception left a pending memo entry");
+    }
+    {
+        Metal::LibraryMemo memo;
+        std::vector<Metal::MetalLibraryObjects> held;
+        for(unsigned i=0;i<1030;++i) held.push_back(memo.Get(std::to_string(i),"main",false,[] {
+            NSObject* token=[NSObject new];
+            return Metal::MetalLibraryObjects{(id<MTLLibrary>)token,(id<MTLFunction>)token,{}};
+        }));
+        if(memo.Stats().entries!=1024 || memo.Stats().builds!=1030) Fail("weak memo capacity/fallback");
+    }
+    setenv("BB_MTL_LIBRARY_REUSE","0",1);
+    {
+        Metal::ShaderCompiler disabled{device,cache/"disabled"};
+        auto a=disabled.Compile(kPatchFrag,0x7e57e000,"disabled_a");
+        auto b=disabled.Compile(kPatchFrag,0x7e57e001,"disabled_b");
+        if(a.status!=CompileStatus::Ok || b.status!=CompileStatus::Ok ||
+           disabled.GetLibraryReuseStats().builds!=0 || disabled.GetLibraryReuseStats().reuses!=0)
+            Fail("library reuse disabled path changed");
+    }
+    if(had_prior) setenv("BB_MTL_LIBRARY_REUSE",previous.c_str(),1);
+    else unsetenv("BB_MTL_LIBRARY_REUSE");
+}
