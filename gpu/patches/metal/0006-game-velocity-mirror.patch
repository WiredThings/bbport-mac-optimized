+namespace {
+u32 FragmentBindingBase(const GraphicsPipeline& pipeline) {
+    u32 base = 0;
+    const auto* fragment = pipeline.GetStages()[u32(Shader::SwStage::Fragment)];
+    for (const auto* stage : pipeline.GetStages()) {
+        if (stage == fragment) break;
+        if (stage) base += stage->buffers.size() + stage->images.size() + stage->samplers.size();
+    }
+    return base;
+}
+bool ReadOnlyStages(const GraphicsPipeline& pipeline) {
+    for (const auto* stage : pipeline.GetStages()) {
+        if (!stage) continue;
+        for (const auto& buffer : stage->buffers) if (buffer.is_written) return false;
+        for (const auto& image : stage->images) if (image.is_written || image.is_atomic) return false;
+    }
+    return true;
+}
+bool FullViewport(const auto& dynamic, const RenderState& state) {
+    const auto& v = dynamic.viewport_scissors;
+    return v.viewports.size() == 1 && v.scissors.size() == 1 &&
+           !dynamic.primitive.rasterizer_discard &&
+           std::abs(v.viewports[0].width) == float(state.width) &&
+           std::abs(v.viewports[0].height) == float(state.height);
+}
+}
+bool Rasterizer::BypassMotionBlur(const GraphicsPipeline& pipeline, const RenderState& state,
+                                   const DynamicDrawState& dynamic) {
+    const auto* fs = pipeline.GetStages()[u32(Shader::SwStage::Fragment)];
+    if (!impl->velocity_requested || BbSettings::Get().startup_effects[2] || !fs ||
+        fs->pgm_hash != 0xe0305cef || !ReadOnlyStages(pipeline)) return false;
+    // Known two fullscreen blur passes: texture 0 is the unblurred scene, texture 1 velocity.
+    const auto fallback = [this] {
+        if (!impl->blur_fallback_logged) {
+            std::printf("Metal motion blur: unsupported final blur permutation; passthrough unavailable, review feature toggle\n");
+            impl->blur_fallback_logged = true;
+        }
+        return false;
+    };
+    const auto& v = dynamic.viewport_scissors;
+    if (state.num_color_attachments != 1 || state.num_layers != 1 || !FullViewport(dynamic, state) ||
+        v.scissors[0].offset.x != 0 || v.scissors[0].offset.y != 0 ||
+        v.scissors[0].extent.width != state.width || v.scissors[0].extent.height != state.height ||
+        v.viewports[0].x != 0 || v.viewports[0].y != 0 || v.viewports[0].width <= 0 || v.viewports[0].height <= 0 ||
+        fs->images.empty()) return fallback();
+    const u32 index = FragmentBindingBase(pipeline) + fs->buffers.size();
+    id<MTLTexture> src = index < impl->num_textures ? (__bridge id<MTLTexture>)impl->textures[index] : nil;
+    id<MTLTexture> dst = (__bridge id<MTLTexture>)reinterpret_cast<void*>(state.color_attachments[0].image_view);
+    if (!src || !dst || src.textureType != MTLTextureType2D || dst.textureType != MTLTextureType2D ||
+        src.sampleCount != 1 || dst.sampleCount != 1 || dst.width != state.width || dst.height != state.height ||
+        !(src.usage & MTLTextureUsageShaderRead)) return fallback();
+    // These game passes use the same color format; reject unexpected permutations.
+    if (src.pixelFormat != dst.pixelFormat) return fallback();
+    if (src != dst) metal_scene_targets->CopyTextures((__bridge const void*)src, (__bridge const void*)dst);
+    if (++impl->blur_copies == 1) std::printf("Metal motion blur: final blur shader replaced with scene copy\n");
+    return true;
+}
+void Rasterizer::ReplayVelocity(const GraphicsPipeline& pipeline, const RenderState& state,
+                                 const DrawCall& draw, const DynamicDrawState& dynamic) {
+    if (!velocity_mirror->Enabled() || pipeline.Tessellation() || pipeline.Geometry()) return;
+    const auto* fs = pipeline.GetStages()[u32(Shader::SwStage::Fragment)];
+    const int packing = fs ? VelocityMirror::PackingBinding(fs->pgm_hash) : -1;
+    if (packing < 0 || !ReadOnlyStages(pipeline) || !FullViewport(dynamic, state)) return;
+    if (!metal_upscaler->WantsVelocity()) {
+        if (!impl->late_velocity_logged) {
+            std::printf("Metal object motion: game velocity outside active pre-upscale phase; camera fallback\n");
