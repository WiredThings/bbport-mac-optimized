diff --git a/gpu/shadps4/video_core/texture_cache/sampler_memo.h b/gpu/shadps4/video_core/texture_cache/sampler_memo.h
new file mode 100644
--- /dev/null
+++ b/gpu/shadps4/video_core/texture_cache/sampler_memo.h
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Adapted from Awakenchan/BloodBorneButPc, engine/bbhost-changes.patch (4f93643e).
+#pragma once
+#include <array>
+#include <bit>
+#include <cstddef>
+#include <cstdint>
+
+namespace VideoCore {
+// A stage-B-only fast path. The texture cache remains the owner and collector; every hit
+// refreshes its LRU once per GC tick. Any collection invalidates all remembered references.
+template <typename Ref, std::size_t Slots = 1024>
+class SamplerMemo {
+public:
+    struct Key {
+        std::array<std::uint64_t, 2> sharp{};
+        std::uint64_t variant{}; // depth flag and exact extra-LOD-bias bits
+        bool operator==(const Key&) const = default;
+    };
+    template <typename Lookup, typename Touch>
+    Ref Get(const Key& key, std::uint64_t generation, std::uint64_t tick,
+            Lookup&& lookup, Touch&& touch) {
+        auto hash = (key.sharp[0] ^ std::rotl(key.sharp[1], 29) ^ key.variant) *
+                    0x9E3779B97F4A7C15ull;
+        hash ^= hash >> 32;
+        auto& entry = entries[hash % Slots];
+        if (entry.valid && entry.generation == generation && entry.key == key) {
+            if (entry.touched_tick != tick) {
+                touch(entry.lru_id);
+                entry.touched_tick = tick;
+            }
+            return entry.ref;
+        }
+        std::size_t lru_id = 0;
+        const Ref ref = lookup(lru_id);
+        entry = {key, ref, lru_id, generation, tick, true};
+        return ref;
+    }
+private:
+    struct Entry {
+        Key key{};
+        Ref ref{};
+        std::size_t lru_id{};
+        std::uint64_t generation{}, touched_tick{};
+        bool valid = false;
+    };
+    std::array<Entry, Slots> entries{};
+};
+} // namespace VideoCore
diff --git a/tests/test_sampler_memo.cpp b/tests/test_sampler_memo.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_sampler_memo.cpp
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Cache lifetime regressions: active hits survive GC; collected/reused slots never escape.
+#include <cassert>
+#include <cstdio>
+#include <unordered_map>
+#include "gpu/shadps4/common/lru_cache.h"
+#include "gpu/shadps4/video_core/texture_cache/sampler_memo.h"
+
+int main() {
+    using Memo = VideoCore::SamplerMemo<unsigned, 1>; // force collisions on every different key
+    Memo memo;
+    Common::LeastRecentlyUsedCache<unsigned, std::uint64_t> lru;
+    std::unordered_map<unsigned, size_t> live;
+    unsigned next = 1, lookups = 0, touches = 0;
+    std::uint64_t generation = 0, tick = 0;
+    const auto get = [&](Memo::Key key) {
+        return memo.Get(key, generation, tick, [&](size_t& id) {
+            ++lookups;
+            const unsigned handle = next++;
+            id = lru.Insert(handle, tick);
+            live.emplace(handle, id);
+            return handle;
+        }, [&](size_t id) {
+            ++touches;
+            lru.Touch(id, tick);
+        });
+    };
+    const auto collect = [&](std::uint64_t older_than) {
+        lru.ForEachItemBelow(older_than, [&](unsigned handle) {
+            const size_t id = live.at(handle);
+            ++generation;
+            live.erase(handle);
+            lru.Free(id);
+            return false;
+        });
+    };
+    const Memo::Key plain{{123, 456}, 0};
+    const auto first = get(plain);
+    for (unsigned i = 0; i < 100000; ++i) assert(get(plain) == first);
+    assert(lookups == 1 && touches == 0);
+    tick = 100;
+    assert(get(plain) == first && touches == 1);
+    collect(99); // a memo hit must keep the owner's LRU alive, without pinning it indefinitely
+    assert(live.contains(first));
+    tick = 200;
+    collect(199);
+    assert(!live.contains(first));
+    const auto second = get(plain); // the freed LRU slot can now be reused
+    assert(second != first && lookups == 2 && touches == 1);
+    auto depth = plain;
+    depth.variant = 1ull << 32;
+    const auto third = get(depth);
+    assert(third != second); // comparison and plain samplers must never alias
+    auto biased = plain;
+    biased.variant = 0x3f800000;
+    assert(get(biased) != third);
+    auto different = plain;
+    different.sharp[1] ^= 1;
+    assert(get(different) != second);
+    assert(get(plain) != first); // hash collisions must compare the entire descriptor
+    std::printf("sampler memo: 100001 repeats use 1 lookup; LRU touch, GC reuse, depth, LOD and collisions passed\n");
+}
