diff --git a/gpu/shadps4/video_core/renderer_metal/mtl_memory_budget.h b/gpu/shadps4/video_core/renderer_metal/mtl_memory_budget.h
new file mode 100644
index 0000000..b30e4b5
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_metal/mtl_memory_budget.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Adapted from bmy/bbport-mac a923b61 + 4de5fd1: count only memory outside
+// the macOS graphics ledger against the process's unified-memory allowance.
+#pragma once
+#include <cstdint>
+
+namespace Metal::MemoryBudget {
+struct ProcessMemory {
+    std::uint64_t outside_graphics{};
+    std::uint64_t graphics{};
+    bool valid{};
+};
+
+inline ProcessMemory FromLedger(std::uint64_t footprint, std::int64_t graphics) {
+    const auto bytes = graphics > 0 ? std::uint64_t(graphics) : 0;
+    return {footprint > bytes ? footprint - bytes : 0, bytes, true};
+}
+
+// currentAllocatedSize includes no-copy wrappers over CPU-owned guest pages.
+// Those pages already occur in outside_graphics: do not charge them twice.
+// Match bmy's max(renderer usage, graphics ledger), after removing the alias.
+inline std::uint64_t GraphicsUsage(std::uint64_t allocated, std::uint64_t imported,
+                                   const ProcessMemory& process) {
+    if (!process.valid) return allocated;
+    const auto owned = allocated > imported ? allocated - imported : 0;
+    return owned > process.graphics ? owned : process.graphics;
+}
+
+inline std::uint64_t Unified(std::uint64_t limit, const ProcessMemory& process) {
+    if (!process.valid) return limit;
+    constexpr std::uint64_t Floor = std::uint64_t{2} << 30;
+    const auto floor = limit < Floor ? limit : Floor;
+    const auto remaining = limit > process.outside_graphics ? limit - process.outside_graphics : 0;
+    return remaining > floor ? remaining : floor;
+}
+} // namespace Metal::MemoryBudget
diff --git a/tests/test_mtl_memory_budget.cpp b/tests/test_mtl_memory_budget.cpp
new file mode 100644
index 0000000..5813130
--- /dev/null
+++ b/tests/test_mtl_memory_budget.cpp
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <cassert>
+#include <cstdint>
+#include <limits>
+#include "video_core/renderer_metal/mtl_memory_budget.h"
+using namespace Metal::MemoryBudget;
+constexpr std::uint64_t GiB = std::uint64_t{1} << 30;
+int main() {
+    assert(Unified(12 * GiB, {}) == 12 * GiB); // OS sample unavailable
+    auto memory = FromLedger(8 * GiB, 5 * GiB);
+    assert(memory.outside_graphics == 3 * GiB);
+    assert(Unified(12 * GiB, memory) == 9 * GiB);
+    // More driver-owned graphics must not recursively shrink the cache budget.
+    assert(GraphicsUsage(8 * GiB, 3 * GiB, memory) == 5 * GiB);
+    assert(GraphicsUsage(12 * GiB, 7 * GiB, memory) == 5 * GiB);
+    assert(GraphicsUsage(2 * GiB, 3 * GiB, memory) == 5 * GiB);
+    assert(GraphicsUsage(8 * GiB, 3 * GiB, {}) == 8 * GiB);
+    const auto larger = FromLedger(12 * GiB, 9 * GiB);
+    assert(Unified(12 * GiB, larger) == Unified(12 * GiB, memory));
+    assert(Unified(12 * GiB, FromLedger(9 * GiB, 5 * GiB)) == 8 * GiB);
+    assert(Unified(12 * GiB, FromLedger(20 * GiB, 0)) == 2 * GiB);
+    assert(Unified(12 * GiB, FromLedger(8 * GiB, -1)) == 4 * GiB);
+    assert(Unified(12 * GiB, FromLedger(2 * GiB, 3 * GiB)) == 12 * GiB);
+    assert(Unified(1 * GiB, FromLedger(8 * GiB, 0)) == 1 * GiB);
+    assert(Unified(0, memory) == 0);
+    assert(Unified(12 * GiB, FromLedger(std::numeric_limits<std::uint64_t>::max(), 0)) == 2 * GiB);
+}
diff --git a/tests/test_texture_cache_gc.cpp b/tests/test_texture_cache_gc.cpp
new file mode 100644
index 0000000..7e1d6ae
--- /dev/null
+++ b/tests/test_texture_cache_gc.cpp
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Livio21/metalborne 6069d161 regression: a blocked LRU prefix must not starve eligible images.
+#include <cassert>
+#include <vector>
+
+#include "gpu/shadps4/common/lru_cache.h"
+
+int main() {
+    struct Image {
+        size_t lru_id;
+        bool blocked;
+        bool evicted = false;
+    };
+
+    Common::LeastRecentlyUsedCache<size_t, u64> lru;
+    std::vector<Image> images;
+    for (size_t i = 0; i < 300; ++i) {
+        images.push_back({lru.Insert(i, 0), true});
+    }
+    images.push_back({lru.Insert(images.size(), 0), false});
+
+    const auto collect = [&](u64 tick) {
+        size_t remaining = 10;
+        size_t visited = 0;
+        lru.ForEachItemBelow(tick - 20, [&](size_t index) {
+            if (remaining == 0 || visited == 256) {
+                return true;
+            }
+            ++visited;
+            auto& image = images[index];
+            if (image.blocked) {
+                lru.Touch(image.lru_id, tick);
+                return false;
+            }
+            --remaining;
+            image.evicted = true;
+            lru.Free(image.lru_id);
+            return false;
+        });
+        return visited;
+    };
+
+    assert(collect(100) == 256);
+    assert(!images.back().evicted);
+    assert(collect(101) == 45);
+    assert(images.back().evicted);
+}
